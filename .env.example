APP_ENV=development
APP_NAME=Lingua AI Translator API
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/lingua
POSTGRES_DB=lingua
POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_password>
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_TIMEOUT_SECONDS=10
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_TIMEOUT_SECONDS=30
SPEECH_RATE_LIMIT_REQUESTS=30
SPEECH_RATE_LIMIT_BYTES=50000000
SPEECH_RATE_LIMIT_CHARACTERS=100000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_CHARACTERS=100000
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=
TRANSLATION_CACHE_ENABLED=false
TRANSLATION_CACHE_TTL_SECONDS=300
OCR_TESSERACT_COMMAND=tesseract
OCR_PROVIDER=tesseract
OCR_TIMEOUT_SECONDS=20
OCR_MAX_UPLOAD_BYTES=8388608
OCR_MAX_PIXELS=20000000
OCR_GOOGLE_CLOUD_ENABLED=false
OCR_GOOGLE_CLOUD_PROJECT_ID=
# Optional service-account JSON. Prefer workload identity/ADC in production.
OCR_GOOGLE_CLOUD_CREDENTIALS_JSON=
OCR_RATE_LIMIT_REQUESTS=30
OCR_RATE_LIMIT_BYTES=100000000

