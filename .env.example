APP_ENV=development
APP_NAME=Lingua AI Translator API
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/lingua
POSTGRES_DB=lingua
POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_password>
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_TIMEOUT_SECONDS=10
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_TIMEOUT_SECONDS=30
SPEECH_RATE_LIMIT_REQUESTS=30
SPEECH_RATE_LIMIT_BYTES=50000000
SPEECH_RATE_LIMIT_CHARACTERS=100000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_CHARACTERS=100000
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=
TRANSLATION_CACHE_ENABLED=false
TRANSLATION_CACHE_TTL_SECONDS=300
OCR_TESSERACT_COMMAND=tesseract
OCR_PROVIDER=tesseract
OCR_TIMEOUT_SECONDS=20
OCR_MAX_UPLOAD_BYTES=8388608
OCR_MAX_PIXELS=20000000
OCR_GOOGLE_CLOUD_ENABLED=false
OCR_GOOGLE_CLOUD_PROJECT_ID=
# Optional service-account JSON. Prefer workload identity/ADC in production.
OCR_GOOGLE_CLOUD_CREDENTIALS_JSON=
OCR_RATE_LIMIT_REQUESTS=30
OCR_RATE_LIMIT_BYTES=100000000
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_MAX_PAGES=30
DOCUMENT_MAX_CHARACTERS=50000
DOCUMENT_MAX_SEGMENT_CHARACTERS=3000
DOCUMENT_JOBS_ENABLED=false
DOCUMENT_GUEST_MODE_ENABLED=false
DOCUMENT_GUEST_CAPABILITY_TOKEN=
DOCUMENT_STORAGE_ROOT=/var/lib/lingua/documents
DOCUMENT_JOB_EXPIRATION_HOURS=24
DOCUMENT_JOB_MAX_ATTEMPTS=3
DOCUMENT_JOB_RATE_LIMIT_REQUESTS=10
DOCUMENT_JOB_TIME_LIMIT_SECONDS=150
# Optional Unicode font path for multilingual PDF export (Noto Sans Myanmar recommended).
DOCUMENT_PDF_FONT_PATH=

# Phase 6A authentication. Passwords are Argon2-hashed; tokens are opaque and hashed in PostgreSQL.
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_ACTION_TOKEN_TTL_SECONDS=900
AUTH_COOKIE_NAME=lingua_session
AUTH_CSRF_COOKIE_NAME=lingua_csrf
AUTH_COOKIE_SECURE=false
AUTH_PUBLIC_BASE_URL=http://localhost:5173
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTH_ACTION_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# Configure all four SMTP fields together for real delivery.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
AUTH_SMTP_STARTTLS=true
# Development-only private mailbox directory; never place it under webroot.
AUTH_DEV_MAILBOX_DIR=

